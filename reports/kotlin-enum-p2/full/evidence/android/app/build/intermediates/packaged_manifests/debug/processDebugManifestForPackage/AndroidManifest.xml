<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.llmasr.minimal"
    android:versionCode="6"
    android:versionName="0.6-debug" >

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:label="Qwen ASR Minimal"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" >
        <activity
            android:name="org.llmasr.minimal.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="org.llmasr.minimal.ModelManagementActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="org.llmasr.minimal.LogsActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name="org.llmasr.minimal.AsrImeService"
            android:exported="true"
            android:label="Qwen ASR 离线语音"
            android:permission="android.permission.BIND_INPUT_METHOD" >
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>