+    setChatTemplate();
+    return success;
+}
+
+bool Llm::clearRequestState() {
+    mContext->os = nullptr;
+    if (!supportsRequestCleanup() || mContext->status != LlmStatus::NORMAL_FINISHED ||
+        !mModule || !mRuntimeManager || !mTokenizer || !mGenerationStrategy) {
+        return false;
+    }
+    if (!clearRequestStateFields()) return false;
+    mContext->status = LlmStatus::RUNNING;
+    return true;
 }

