+        mContext->history_tokens.clear();
+        mContext->output_tokens.clear();
+        mContext->generate_str.clear();
+        mContext->end_with.clear();
+        mContext->log_buffer.clear();
+    }
+    mContext->prompt_len = mContext->gen_seq_len = mContext->all_seq_len = 0;
+    mContext->current_token = -1;
+    mContext->vision_us = mContext->audio_us = mContext->prefill_us = mContext->decode_us = 0;
+    mContext->sample_us = mContext->ttfa_us = 0;
+    mContext->pixels_mp = mContext->audio_input_s = 0.0f;
+    mGenerateParam->input_ids.clear();
+    mGenerateParam->input_embeds = nullptr;
+    mGenerateParam->outputs.clear();
+    mGenerateParam->validLogitStart = mGenerateParam->validLogitSize = 0;
+    mGenerateParam->max_new_tokens = 0;
+    mGenerateParam->timeout_ms = mConfig->timeout_ms();
+    inputsEmbeds = attentionMask = positionIds = nullptr;
+    mPleInput = mTextEmbedsForPle = nullptr;
+    mCachedPromptText.clear();
+    for (auto var : mPositionIdsVarVec) {
+        const auto info = var->getInfo();
+        auto ptr = var->writeMap<int>();
+        if (!info || !ptr || info->type.code != halide_type_int || info->type.bits != 32) {
+            success = false;
+            continue;
+        }
+        std::fill(ptr, ptr + info->size, 0);
+    }
+    for (auto var : mAttentionMaskVarVec) {
+        const auto info = var->getInfo();
+        auto ptr = var->writeMap<float>();
+        if (!info || !ptr || info->type.code != halide_type_float || info->type.bits != 32) {
+            success = false;
+            continue;
+        }
+        std::fill(ptr, ptr + info->size, 0.0f);
+    }
